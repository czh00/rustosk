{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustosk",
  "version": "1.0.0",
  "identifier": "com.tauri-app.rustosk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": null,
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rustosk",
        "width": 723,
        "height": 310,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "run-rustosk",
          "cmd": "rustosk.exe",
          "sidecar": false
        }
      ]
    }
  }
}
